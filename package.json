{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx serverEntry.ts",
    "build": "vite build && esbuild serverEntry.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.cjs",
    "lint": "tsc --noEmit",
    "verify:kcc-brain-fail-closed": "tsx scripts/verifyKccBrainFailClosed.ts",
    "verify:async-worker-fail-closed": "tsx scripts/verifyAsyncWorkerFailClosed.ts",
    "verify:provider-execution-fail-closed": "tsx scripts/verifyProviderExecutionFailClosed.ts",
    "verify:real-provider-boundary": "tsx scripts/verifyRealProviderBoundary.ts",
    "verify:real-notification-boundary": "tsx scripts/verifyRealNotificationBoundary.ts",
    "verify:whatsapp-delivery-evidence": "tsx scripts/verifyWhatsAppDeliveryEvidence.ts",
    "verify:production-readiness-truth": "tsx scripts/verifyProductionReadinessTruth.ts",
    "verify:server-entry-runtime": "tsx scripts/verifyServerEntryRuntime.ts",
    "verify:security-fail-closed": "tsx scripts/verifySecurityFailClosed.ts",
    "verify:production-commerce-guard": "tsx scripts/verifyProductionCommerceGuard.ts",
    "verify:kcc-alive-gate": "tsx scripts/verifyKccAliveGate.ts",
    "verify:canonical-fulfillment-path": "tsx scripts/verifyCanonicalFulfillmentPath.ts",
    "verify:paypal-fail-closed": "tsx scripts/verifyPayPalFailClosed.ts",
    "verify:reality-evidence-boundary": "tsx scripts/verifyRealityEvidenceBoundary.ts",
    "test": "npm run verify:kcc-brain-fail-closed && npm run verify:provider-execution-fail-closed && npm run verify:async-worker-fail-closed && tsx scripts/verifyProductionFailClosed.ts && npm run verify:kcc-alive-gate && npm run verify:canonical-fulfillment-path && npm run verify:paypal-fail-closed && npm run verify:reality-evidence-boundary"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.7",
    "@types/jsonwebtoken": "^9.0.10",
    "@vitejs/plugin-react": "^5.0.4",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/express": "^4.17.21",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
