# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PAYPAL CREDENTIALS
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_MODE="sandbox"
PAYPAL_WEBHOOK_ID=""

# CJ DROPSHIPPING CREDENTIALS
CJ_DROPSHIPPING_EMAIL=""
CJ_DROPSHIPPING_API_KEY=""

# WHATSAPP CLOUD API CREDENTIALS
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# SUPABASE PERSISTENCE CREDENTIALS
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# SINGLE OWNER SECURITY CONFIGURATION
ADMIN_EMAIL="samraboss@gmail.com"
ADMIN_PASSWORD_HASH=""
JWT_SECRET=""

# CHATGPT & CUSTOM GPT INTEGRATION BRIDGE SECRET KEY
KCC_CHATGPT_SECRET=""

# GITHUB INTEGRATION AUTOMATION TOKEN
GITHUB_TOKEN=""

# PRODUCTION EXECUTION SAFETY
# local is development/test only; production must use a durable storage driver.
STORAGE_DRIVER="local"
# Production default: false. Enable only for controlled long-running deployments.
ENABLE_CONTINUOUS_LOOP="false"
MISSION_TICK_MAX_MISSIONS="3"
AGENT_QUEUE_BATCH_SIZE="3"
# Secret for external batch execution triggers. Never expose this publicly.
KCC_EXECUTION_SECRET=""
