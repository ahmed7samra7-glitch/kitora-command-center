# GEMINI_API_KEY: Required only when the Gemini AI provider is intentionally configured.
# Keep secrets in the chosen staging host's secret store; never commit them.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Optional public staging URL, used for links, callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PAYPAL CREDENTIALS
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
# Sandbox only. Do not switch this project to PayPal Live without explicit owner approval.
PAYPAL_MODE="sandbox"

# CJ DROPSHIPPING CREDENTIALS
CJ_DROPSHIPPING_EMAIL=""
CJ_DROPSHIPPING_API_KEY=""

# WHATSAPP CLOUD API CREDENTIALS
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# SUPABASE PERSISTENCE CREDENTIALS
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# SINGLE OWNER SECURITY CONFIGURATION
ADMIN_EMAIL="samraboss@gmail.com"
ADMIN_PASSWORD_HASH=""
JWT_SECRET=""

# CHATGPT & CUSTOM GPT INTEGRATION BRIDGE SECRET KEY
KCC_CHATGPT_SECRET=""

# GITHUB INTEGRATION AUTOMATION TOKEN
GITHUB_TOKEN=""



# KCC provider evidence signing secret. Required to issue and verify fresh provider receipts.
# Keep this only in the deployment secret store; never commit the real value.
KCC_PROVIDER_EVIDENCE_SECRET="MY_KCC_PROVIDER_EVIDENCE_SECRET"

# Cloudflare Worker task submission secret (store only in Cloudflare Secrets)
KCC_WORKER_SECRET=""

# Non-secret Cloudflare Worker AI selection
KCC_AI_PROVIDER="gemini"
GEMINI_MODEL="gemini-3.6-flash"
